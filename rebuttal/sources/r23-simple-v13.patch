+package runner
+
+import "flag"
+
+var neighborAbstract = flag.String("neighbor-abstract", "off", "IOMMU aggregate-walker Neighbor adaptation: off, full, full-nosched.")
+
+func validateSimpleComparisonFlags() {
+	if !*latpcSimple && *neighborAbstract == "off" {
+		return
+	}
+	if !*gmmuVPNMSHRBaseline || !*mmutlbVPNMSHRBaseline || !*ptwDemandPTEOnly || !*mmutlbDemandPTEOnly ||
+		*gmmuFlexTLB || *mmutlbFlexTLB || *gmmuIdleIOMMUAssist || *mmuWalkCoalescing ||
+		*iommuFixedWalkLatency != 0 || configuredLog2PageSize() != 12 ||
+		(*latpcSimple && *neighborAbstract != "off") {
+		panic("simple SOTA comparison requires ordinary VPN MSHRs, native demand-only walks, and no PASTA/other policy")
+	}
+}
+
+func configuredNeighborAbstract() string { validateSimpleComparisonFlags(); return *neighborAbstract }
+
+func (r *Runner) reportNeighborAbstract() {
+	if len(r.platform.GPUs) == 0 || r.platform.GPUs[0].MMUEngine == nil {
+		return
+	}
+	policy, s := r.platform.GPUs[0].MMUEngine.NeighborAbstractStats()
+	r.metricsCollector.Collect("RebuttalConfig", "neighbor_abstract_policy", float64(policy))
+	for name, count := range map[string]uint64{
+		"neighbor_abstract_leaf_returns":         s.LeafReturns,
+		"neighbor_abstract_pending_completions":  s.PendingCompletions,
+		"neighbor_abstract_demand_pages":         s.DemandPages,
+		"neighbor_abstract_levels_skipped":       s.LevelsSkipped,
+		"neighbor_abstract_scheduler_held_ticks": s.SchedulerHeldTicks,
+		"neighbor_abstract_timeout_starts":       s.TimeoutStarts,
+		"neighbor_abstract_partial_l2":           s.PartialEvents[2],
+		"neighbor_abstract_partial_l3":           s.PartialEvents[3],
+		"neighbor_abstract_partial_l4":           s.PartialEvents[4],
+		"neighbor_abstract_partial_l5":           s.PartialEvents[5],
+	} {
+		r.metricsCollector.Collect("MMU", name, float64(count))
+	}
+}
