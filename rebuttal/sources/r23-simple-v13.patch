+package runner
+
+import (
+	"encoding/json"
+	"flag"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/sarchlab/akita/v3/mem/mem"
+	"github.com/sarchlab/akita/v3/mem/vm"
+	"github.com/sarchlab/akita/v3/mem/vm/translationtrace"
+	"github.com/sarchlab/akita/v3/sim"
+)
+
+// Construct only translation components, never a GPU workload or engine run.
+func TestR2ActualTranslationBuilders(t *testing.T) {
+	var jobs []struct {
+		ID       string   `json:"id"`
+		Command  []string `json:"command"`
+		Variant  string   `json:"r2_variant"`
+		Capacity int      `json:"gmmu_mshr_entries"`
+	}
+	data, err := os.ReadFile(os.Getenv("R2_JOBS_JSON"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = json.Unmarshal(data, &jobs); err != nil || len(jobs) == 0 {
+		t.Fatal("missing R2 jobs", err)
+	}
+	for _, job := range jobs {
+		t.Run(job.ID, func(t *testing.T) {
+			// Each campaign command runs in a new process; do not inherit the
+			// previous subtest's flags when reproducing that environment.
+			saved := map[string]string{}
+			flag.VisitAll(func(f *flag.Flag) {
+				if !strings.HasPrefix(f.Name, "test.") {
+					saved[f.Name] = f.Value.String()
+					if err := flag.Set(f.Name, f.DefValue); err != nil {
+						t.Fatal(err)
+					}
+				}
+			})
+			t.Cleanup(func() {
+				for name, value := range saved {
+					if err := flag.Set(name, value); err != nil {
+						t.Error(err)
+					}
+				}
+				translationtrace.Configure(false, "", 100000)
+			})
+			seen := map[string]bool{}
+			for _, arg := range job.Command[1:] {
+				name, value, found := strings.Cut(strings.TrimPrefix(arg, "-"), "=")
+				if name == "benchmark" {
+					continue
+				}
+				if !found {
+					value = "true"
+				}
+				if seen[name] || flag.Lookup(name) == nil {
+					t.Fatalf("duplicate/unregistered flag %s", name)
+				}
+				seen[name] = true
+				if err := flag.Set(name, value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			translationtrace.Configure(false, "", 100000)
+			engine := sim.NewSerialEngine()
+			table := mem.NewMultiPageFinder()
+			p := R9NanoPlatformBuilder{engine: engine, log2PageSize: 12}
+			var pt vm.PageTable
+			p.mmu, pt = p.createMMU(engine, table)
+			p.createIOMMUCache()
+			p.createIOMMUTLB(table, pt)
+			g := R9NanoGPUBuilder{engine: engine, freq: sim.GHz, gpuID: 1, gpuName: "R2Contract.GPU",
+				gpu: &GPU{Domain: sim.NewDomain("R2Contract.GPU")}, pageTable: pt, log2PageSize: 12,
+				mmu: p.mmu, IOMMUCache: p.IOMMUTLB, gmmuCacheTable: table}
+			g.buildGMMU()
+			g.buildGMMUCache()
+			l2, io := g.gmmuCache, p.IOMMUTLB
+			baseline := job.Variant == "baseline16" || job.Variant == "baseline_equal_area"
+			full := job.Variant == "pasta16"
+			if !baseline && !full && job.Variant != "m1_demand_only" {
+				t.Fatal("unknown variant")
+			}
+			low, high := l2.PTCLThresholds()
+			assist, _, _, _ := l2.IdleIOMMUAssistStats()
+			line, _, _, _, _, _, _, _, rows := io.SetAsLineStats()
+			sets, ways, _ := l2.TLBGeometry()
+			wantLow, wantHigh := 0, 0
+			if baseline {
+				wantHigh = 1000000
+			}
+			if full {
+				wantLow, wantHigh = 4, 16
+			}
+			// The frozen IOTLB has no capacity getter; inspect its actual
+			// integer field without changing production code or using unsafe.
+			ioCapacity := reflect.ValueOf(io).Elem().FieldByName("mshr").Elem().Elem().FieldByName("capacity").Int()
+			if l2.VPNMSHRBaselineEnabled() != baseline || io.VPNMSHRBaselineEnabled() != baseline ||
+				io.DemandPTEOnlyEnabled() == full || *ptwDemandPTEOnly == full ||
+				l2.PTCLModeEnabled() != (job.Variant == "m1_demand_only") ||
+				low != wantLow || high != wantHigh || assist != full || line != full ||
+				rows != 0 || (l2.PLTStudyStats()["plt_total_rows"] > 0) != full ||
+				p.mmu.WalkCoalescingEnabled() || l2.PTCLLineSize() != 8 ||
+				l2.PTELookupLatencyCycles() != 32 || l2.PTELookupSlotLimit() != 8 || io.LookupLatencyCycles() != 80 ||
+				sets != 16 || ways != 16 || l2.MSHRAdmissionStats()["mshr_entry_capacity"] != float64(job.Capacity) ||
+				l2.MSHRAdmissionStats()["mshr_entry_capacity_unbounded"] != 0 ||
+				ioCapacity != 64 ||
+				g.gmmu.PTWCapacity() != 4 || p.mmu.PTWCapacity() != 16 ||
+				l2.IOMMUPort != io.GetPortByName("Top") || *maxWGCount != 76800 || *numGPMs != 48 ||
+				engine.CurrentTime() != 0 {
+				t.Fatal("R2 flags did not reach expected translation configuration")
+			}
+			t.Logf("R2_RUNNER id=%s variant=%s capacity=%d no_gpu_workload=true", job.ID, job.Variant, job.Capacity)
+		})
+	}
+}
