+	"os"
+	"strings"
+	"testing"
+)
+
+func TestR23SimpleVectorAndPolicyFlags(t *testing.T) {
+	var jobs []struct {
+		ID, Config string
+		Command    []string
+	}
+	data, err := os.ReadFile(os.Getenv("R2_JOBS_JSON"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = json.Unmarshal(data, &jobs); err != nil || len(jobs) == 0 {
+		t.Fatal("missing jobs", err)
+	}
+	for _, job := range jobs {
+		t.Run(job.ID, func(t *testing.T) {
+			saved := map[string]string{}
+			flag.VisitAll(func(f *flag.Flag) {
+				if !strings.HasPrefix(f.Name, "test.") {
+					saved[f.Name] = f.Value.String()
+					if err := flag.Set(f.Name, f.DefValue); err != nil {
+						t.Fatal(err)
+					}
+				}
+			})
+			t.Cleanup(func() {
+				for name, value := range saved {
+					if err := flag.Set(name, value); err != nil {
+						t.Error(err)
+					}
+				}
+			})
+			for _, arg := range job.Command[1:] {
+				name, value, found := strings.Cut(strings.TrimPrefix(arg, "-"), "=")
+				if name == "benchmark" {
+					continue
+				}
+				if !found {
+					value = "true"
+				}
+				if err := flag.Set(name, value); err != nil {
+					t.Fatal(err)
+				}
+			}
+			wantLATPC := job.Config == "latpc_simple"
+			wantNeighbor := "off"
+			if job.Config == "neighbor_abstract" {
+				wantNeighbor = "full"
+			}
+			if configuredLATPC() != wantLATPC || configuredNeighborAbstract() != wantNeighbor {
+				t.Fatal("wrong policy")
+			}
+			b := makeShaderArrayBuilder().withEngine(sim.NewSerialEngine()).withNumCU(1)
+			sa := &shaderArray{}
+			b.buildL1VTLBs(sa)
+			enabled, capacity, _ := sa.l1vTLBs[0].LATPCStats()
+			if enabled != wantLATPC || capacity != 4 {
+				t.Fatal("wrong L1 nominal capacity or LATC mode")
+			}
+		})
+	}
+}
+
+func TestR23RejectMixedPASTA(t *testing.T) {
+	oldN, oldL, oldVPN := *neighborAbstract, *latpcSimple, *gmmuVPNMSHRBaseline
+	t.Cleanup(func() { *neighborAbstract, *latpcSimple, *gmmuVPNMSHRBaseline = oldN, oldL, oldVPN })
+	*neighborAbstract, *latpcSimple, *gmmuVPNMSHRBaseline = "full", true, false
+	defer func() {
+		if recover() == nil {
+			t.Error("mixed PASTA policy accepted")
+		}
+	}()
+	validateSimpleComparisonFlags()
+}
