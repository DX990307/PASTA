+func TestLATPCMetadataThroughROB(t *testing.T) {
+	info := vm.DetectLATPC([]uint64{8, 10})[1]
+	b := &ReorderBuffer{}
+	read := mem.ReadReqBuilder{}.WithAddress(10 << 12).WithByteSize(4).WithPID(1).WithInfo(info).Build()
+	write := mem.WriteReqBuilder{}.WithAddress(10 << 12).WithPID(1).WithData([]byte{1, 2, 3, 4}).WithInfo(info).Build()
+	if b.duplicateReadReq(read).Info != info || b.duplicateWriteReq(write).Info != info {
+		t.Fatal("ROB lost stride metadata")
+	}
+}
