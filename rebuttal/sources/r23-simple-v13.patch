+package runner
+
+import (
+	"flag"
+	"github.com/sarchlab/akita/v3/mem/vm/tlb"
+)
+
+var latpcSimple = flag.Bool("latpc-simple", false, "LATPC L1 compression and optimistic aggregate-walker batching; no DRAM-row model.")
+
+func configuredLATPC() bool { validateSimpleComparisonFlags(); return *latpcSimple }
+
+func (r *Runner) reportLATPCSimple() {
+	enabled := 0.0
+	if *latpcSimple {
+		enabled = 1
+	}
+	r.metricsCollector.Collect("RebuttalConfig", "latpc_simple", enabled)
+	for _, gpu := range r.platform.GPUs {
+		for _, component := range gpu.L1VTLBs {
+			l1 := component.(*tlb.TLB)
+			on, capacity, s := l1.LATPCStats()
+			active := 0.0
+			if on {
+				active = 1
+			}
+			for name, value := range map[string]float64{
+				"latpc_enabled": active, "latpc_entry_capacity": float64(capacity),
+				"latpc_entries_allocated": float64(s.Allocated), "latpc_compressed_misses": float64(s.CompressedMisses),
+				"latpc_hit_under_miss": float64(s.HitUnderMiss), "latpc_full_observations": float64(s.FullObservations),
+				"latpc_peak_entries": float64(s.PeakEntries),
+			} {
+				r.metricsCollector.Collect(l1.Name(), name, value)
+			}
+		}
+		_, merged := gpu.GMMUEngine.LATPCStats()
+		r.metricsCollector.Collect(gpu.GMMUEngine.Name(), "latpc_batched_requests", float64(merged))
+	}
+	if len(r.platform.GPUs) > 0 {
+		_, merged := r.platform.GPUs[0].MMUEngine.LATPCStats()
+		r.metricsCollector.Collect("MMU", "latpc_batched_requests", float64(merged))
+	}
+}
