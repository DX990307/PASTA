+		inst.Dst = insts.NewVRegOperand(0, 0, 1)
+		wf.SetDynamicInst(wavefront.NewInst(inst))
+		sp := wf.Scratchpad().AsFlat()
+		sp.EXEC = 15
+		vpns := []uint64{22, 20, 18, 16}
+		for lane, vpn := range vpns {
+			sp.ADDR[lane] = vpn << 12
+		}
+		for _, enabled := range []bool{false, true} {
+			c := defaultCoalescer{log2CacheLineSize: 6, latpcEnabled: enabled}
+			transactions := c.generateMemTransactions(wf)
+			if len(transactions) != 4 {
+				t.Fatal("unexpected transaction count")
+			}
+			for lane, transaction := range transactions {
+				var value interface{}
+				if transaction.Read != nil {
+					value = transaction.Read.Info
+				} else {
+					value = transaction.Write.Info
+				}
+				if !enabled {
+					if value != nil {
+						t.Fatal("baseline annotated")
+					}
+					continue
+				}
+				info, ok := value.(vm.LATPCInfo)
+				if !ok || !info.Matches(vpns[lane]) || info.BaseVPN != 22 || info.Index != uint8(lane) {
+					t.Fatal("lane order or negative stride metadata lost")
+				}
+			}
+		}
